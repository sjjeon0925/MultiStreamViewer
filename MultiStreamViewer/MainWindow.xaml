<Window x:Class="MultiStreamViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi Stream Viewer"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        Background="#101010"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopBarRow" Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomStatusBarRow" Height="32"/>
        </Grid.RowDefinitions>

        <!-- 상단 툴바 -->
        <Border x:Name="TopBar"
                Grid.Row="0"
                Background="#1B1B1B"
                BorderBrush="#303030"
                BorderThickness="0,0,0,1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <!-- 프로그램 이름 + 분할 버튼 -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0">

                        <TextBlock Text="Multi Stream Viewer"
                                   Foreground="#FFFFFF"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="  •  5-Platform"
                                   Foreground="#777777"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="5,4,0,0"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,15,0">

                        <TextBlock Text="분할"
                                   Foreground="#999999"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <Button Content="1"
                                Tag="1"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click"/>

                        <Button Content="2"
                                Tag="2"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click"/>

                        <Button Content="3"
                                Tag="3"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click"/>

                        <Button Content="4"
                                Tag="4"
                                Style="{StaticResource LayoutButtonStyle}"
                                Click="LayoutButton_Click"/>

                        <Button Content="⛶"
                                Margin="12,0,0,0"
                                Style="{StaticResource LayoutButtonStyle}"
                                ToolTip="전체화면 (Esc로 해제)"
                                Click="FullscreenButton_Click"/>

                    </StackPanel>

                </Grid>

                <!-- 방송 연결 및 링크 추출 -->
                <Grid Grid.Row="1"
                      Margin="12,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SlotSelector"
                              Grid.Column="0"
                              Height="34"
                              Margin="0,0,8,0"
                              Background="#242424"
                              Foreground="#777777"
                              BorderBrush="#444444"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0">
                        <ComboBoxItem Content="슬롯 1"/>
                        <ComboBoxItem Content="슬롯 2"/>
                        <ComboBoxItem Content="슬롯 3"/>
                        <ComboBoxItem Content="슬롯 4"/>
                    </ComboBox>

                    <TextBox x:Name="UrlTextBox"
                             Grid.Column="1"
                             Style="{StaticResource DarkTextBoxStyle}"
                             ToolTip="방송 URL을 입력하세요"
                             Text=""/>

                    <Button Grid.Column="2"
                            Content="연결"
                            Margin="5,0,0,0"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="ConnectButton_Click"/>

                    <Button Grid.Column="3"
                            Content="해제"
                            Margin="5,0,0,0"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="DisconnectButton_Click"/>

                    <Button Grid.Column="4"
                            Content="현재 링크"
                            Margin="16,0,0,0"
                            ToolTip="선택한 슬롯이 지금 보고 있는 주소를 주소창에 채우고 복사합니다"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="CurrentLinkButton_Click"/>

                    <Button Grid.Column="5"
                            Content="처음 링크"
                            Margin="5,0,0,0"
                            ToolTip="선택한 슬롯에 처음 연결한 주소를 주소창에 채우고 복사합니다"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="InitialLinkButton_Click"/>

                </Grid>

            </Grid>

        </Border>

        <!-- 방송 영역 -->
        <Grid Grid.Row="1"
              x:Name="StreamGrid"
              Margin="3"/>

        <!-- 하단 상태바 -->
        <Border x:Name="BottomStatusBar"
                Grid.Row="2"
                Background="#181818"
                BorderBrush="#303030"
                BorderThickness="0,1,0,0">

            <Grid>

                <TextBlock x:Name="StatusText"
                           Text="준비됨"
                           Foreground="#777777"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="10,0"/>

                <TextBlock Text="Windows 11"
                           Foreground="#555555"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

            </Grid>

        </Border>

    </Grid>

</Window>
