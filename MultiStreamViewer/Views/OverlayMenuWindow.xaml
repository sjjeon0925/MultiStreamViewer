<Window x:Class="MultiStreamViewer.Views.OverlayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        WebView2는 별도 HWND로 그려져서 같은 창 안의 WPF 요소를 위에 겹칠 수 없다(airspace 문제).
        그래서 방송 영역 위에 뜨는 메뉴는 메인 창이 소유하는 투명한 작은 창으로 만든다.
        창 크기와 버튼 배치는 코드(OverlayMenuWindow.xaml.cs)에서 기능 버튼 개수에 맞춰 정해진다.
        버튼이 없는 부분은 완전 투명이라 클릭이 아래 방송 화면으로 통과한다.
    -->

    <Window.Resources>

        <!-- 동그란 반투명 버튼. 마우스를 올리면 또렷해진다. -->
        <Style x:Key="OverlayButtonStyle"
               TargetType="Button">

            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#666666"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#4A4A4A"/>
                                <Setter Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Canvas x:Name="Root"/>

</Window>
