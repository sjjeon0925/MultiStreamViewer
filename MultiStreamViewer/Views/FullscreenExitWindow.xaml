<Window x:Class="MultiStreamViewer.Views.FullscreenExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Width="72"
        Height="48"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        전체화면에서 마우스를 화면 맨 위로 가져가면 내려오는 종료(✕) 버튼 (크롬 전체화면처럼).
        WebView2 위에는 같은 창의 WPF 요소를 겹칠 수 없어서 별도의 투명한 소유 창으로 만든다.
        숨겨져 있는 동안에는 클릭이 아래 방송 화면으로 통과한다.
    -->

    <Border x:Name="Pill"
            CornerRadius="0,0,14,14"
            Background="#E6202020"
            BorderBrush="#66FFFFFF"
            BorderThickness="1,0,1,1"
            Opacity="0">

        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="-48"/>
        </Border.RenderTransform>

        <Button x:Name="ExitButton"
                Content="✕"
                ToolTip="전체화면 종료 (Esc)"
                Foreground="#EEEEEE"
                FontSize="18"
                Cursor="Hand"
                Click="ExitButton_Click">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="0,0,14,14">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CC3333"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

        </Button>

    </Border>

</Window>
