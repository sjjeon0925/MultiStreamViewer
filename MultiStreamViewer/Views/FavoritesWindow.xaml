<Window x:Class="MultiStreamViewer.Views.FavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="즐겨찾기"
        Width="460"
        Height="540"
        MinWidth="360"
        MinHeight="400"
        Background="#1B1B1B"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="CaretBrush" Value="#EEEEEE"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="항목을 클릭하면 열 슬롯을 고를 수 있어요"
                   Foreground="#999999"
                   Margin="0,0,0,10"/>

        <!-- 즐겨찾기 목록: 항목 클릭 = 선택, ✕ = 삭제 -->
        <ListBox x:Name="FavoriteList"
                 Grid.Row="1"
                 Background="#151515"
                 BorderBrush="#303030"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="FavoriteList_SelectionChanged">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#EEEEEE"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Url}"
                                       Foreground="#808080"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="✕"
                                ToolTip="삭제"
                                Width="28"
                                Height="28"
                                Margin="8,0,0,0"
                                Style="{StaticResource DarkButtonStyle}"
                                Padding="0"
                                Tag="{Binding}"
                                Click="DeleteButton_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- 추가 -->
        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0">

            <TextBlock Text="새 즐겨찾기 추가"
                       Foreground="#999999"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="NameBox"
                     Style="{StaticResource DarkTextBoxStyle}"
                     ToolTip="이름 (비워두면 주소로 자동 설정)"
                     Margin="0,0,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UrlBox"
                         Grid.Column="0"
                         Style="{StaticResource DarkTextBoxStyle}"
                         ToolTip="방송 주소"/>

                <Button Grid.Column="1"
                        Content="추가"
                        Margin="6,0,0,0"
                        Style="{StaticResource DarkButtonStyle}"
                        Click="AddButton_Click"/>
            </Grid>

            <TextBlock x:Name="MessageText"
                       Foreground="#E57373"
                       FontSize="11"
                       Margin="0,6,0,0"/>

        </StackPanel>

    </Grid>

</Window>
